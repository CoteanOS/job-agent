# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Telegram ---
# token from @BotFather. Chat id is printed by /start on first run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- which roles to keep ---
# comma separated keywords matched against the job title
JOB_KEYWORDS=business analyst

# --- behaviour ---
MAX_PER_RUN=5
CYCLE_HOURS=24

# --- your details for the application form ---
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
